[Unit]
Description=Ethereum Rust Live Block Processor
After=network-online.target reth.service redis-server.service
Wants=network-online.target reth.service redis-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
User=nima
Group=nima
WorkingDirectory=/home/nima/code/crypto/blockchains/eth

Environment="PATH=/home/nima/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/home/nima/code/crypto/blockchains/eth/config.env
Environment="ETH_CONFIG_PATH=/home/nima/code/crypto/blockchains/eth/config.env"
Environment="RUST_LOG=info"
Environment="ETH_PROCESSED_BLOCK_STREAM=eth/live/blocks"
Environment="ETH_LIVE_REDIS_MAX_BLOCKS=10"
Environment="REDIS_BLOCK_CHANNEL=eth/live/block_notifications"
Environment="LIVE_BLOCK_LOG_DIR=/home/nima/code/crypto/blockchains/eth/logs/block_processor"

ExecStart=/home/nima/code/crypto/blockchains/eth/target/release/live_block_processor

StandardOutput=journal
StandardError=journal

MemoryMax=8G
Nice=0
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
