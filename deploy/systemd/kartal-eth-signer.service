[Unit]
Description=Kartal ETH local signer
Documentation=file:/home/nima/code/crypto/kartal/src/eth_signer/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nima
Group=kartal
WorkingDirectory=/home/nima/code/crypto/kartal
Environment=KARTAL_CONFIG_PATH=/home/nima/code/crypto/kartal/config.toml
Environment=KARTAL_ETH_SIGNER_SOCKET_PATH=/run/kartal/eth-signer.sock
Environment=KARTAL_ETH_SIGNER_SOCKET_MODE=0660
Environment=KARTAL_ETH_SIGNER_KEY_BACKEND=keystore
EnvironmentFile=-/etc/kartal/eth-signer.env
ExecStart=/home/nima/code/crypto/kartal/target/release/run_kartal_eth_signer
Restart=on-failure
RestartSec=2s
RuntimeDirectory=kartal
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/kartal /home/nima/code/crypto/kartal/.state
ReadOnlyPaths=/home/nima/code/crypto/kartal /home/nima/code/crypto/blockchains/eth

[Install]
WantedBy=multi-user.target
