[Unit]
Description=Ethereum Mempool Signal Processor
After=network-online.target reth.service redis-server.service eth-live-block-processor.service
Wants=network-online.target reth.service redis-server.service eth-live-block-processor.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
User=nima
Group=nima
WorkingDirectory=/home/nima/code/crypto/blockchains/eth

Environment="PATH=/home/nima/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/home/nima/code/crypto/blockchains/eth/config.env
Environment="ETH_CONFIG_PATH=/home/nima/code/crypto/blockchains/eth/config.env"
Environment="RUST_LOG=info"
Environment="MEMPOOL_LOG_DIR=/home/nima/code/crypto/blockchains/eth/logs/mempool_processor"
Environment="MEMPOOL_ZMQ_SIGNAL_ENDPOINT=tcp://127.0.0.1:5556"
Environment="MEMPOOL_TOKEN_CACHE_PUB_ENDPOINT=tcp://127.0.0.1:5557"

ExecStart=/home/nima/code/crypto/blockchains/eth/target/release/mempool_signal_detector --batch-size 100 --sim-workers 4 --report-interval 30

StandardOutput=journal
StandardError=journal

MemoryMax=8G
Nice=0
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
