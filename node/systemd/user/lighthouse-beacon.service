[Unit]
Description=Ethereum Lighthouse beacon node
Wants=network-online.target reth.service
After=network-online.target reth.service

[Service]
Type=simple
WorkingDirectory=/home/nima
ExecStart=/home/nima/storage/samsung8tb/ethereum/bin/lighthouse bn \
  --network mainnet \
  --datadir /home/nima/.lighthouse \
  --execution-endpoint http://127.0.0.1:8551 \
  --execution-jwt /home/nima/storage/samsung8tb/ethereum/jwt/jwt.hex \
  --checkpoint-sync-url https://mainnet.checkpoint.sigp.io \
  --http \
  --http-address 127.0.0.1 \
  --http-port 5052 \
  --metrics \
  --metrics-address 127.0.0.1 \
  --metrics-port 5054 \
  --port 9000 \
  --discovery-port 9000
Restart=always
RestartSec=5
LimitNOFILE=1000000

[Install]
WantedBy=default.target
