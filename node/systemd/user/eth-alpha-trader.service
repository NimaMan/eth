[Unit]
Description=Ethereum alpha trader
Wants=network-online.target eth-mempool-signal-detector.service
After=network-online.target eth-mempool-signal-detector.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/nima/code/crypto/blockchains/eth/reth
EnvironmentFile=-/home/nima/code/crypto/blockchains/eth/config.env
Environment=ETH_CONFIG_PATH=/home/nima/code/crypto/blockchains/eth/config.env
Environment=PATH=/home/nima/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RUST_LOG=info
ExecStart=/home/nima/code/crypto/blockchains/eth/reth/target/release/eth_alpha_trader --token-server-url http://127.0.0.1:8765 --poll-interval-ms 2000 --mempool-since-days 14 --signal-limit 200
Restart=always
RestartSec=5
LimitNOFILE=1000000

[Install]
WantedBy=default.target
