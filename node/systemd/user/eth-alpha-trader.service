[Unit]
Description=Ethereum alpha trader (no-capital chain simulation)
Wants=network-online.target eth-chain-server.service eth-mempool-signal-detector.service
After=network-online.target eth-chain-server.service eth-mempool-signal-detector.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/nima/code/crypto/blockchains/eth
EnvironmentFile=-/home/nima/code/crypto/blockchains/eth/config.env
Environment=ETH_CONFIG_PATH=/home/nima/code/crypto/blockchains/eth/config.env
Environment=PATH=/home/nima/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RUST_LOG=info
ExecStart=/home/nima/code/crypto/blockchains/eth/target/release/eth_alpha_live_backtest_trader --run-id alpha11-live-gasguard-hold-sweep-chain-sim-20260519-194813 --poll-interval-ms 2000 --mempool-since-days 14 --signal-limit 200 --min-liquidity-eth 0.5 --min-liquidity-usd 1000 --strategy-suite alpha11-live-gasguard-hold-sweep
Restart=always
RestartSec=5
LimitNOFILE=1000000

[Install]
WantedBy=default.target
