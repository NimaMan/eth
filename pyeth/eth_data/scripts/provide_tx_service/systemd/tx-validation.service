[Unit]
Description=Transaction Validation Service
Documentation=Python transaction processor validation service for Rust integration
After=network.target
Wants=network.target

[Service]
Type=simple
User=nima
Group=nima
WorkingDirectory=/home/nima/code/crypto/py/eth_data/scripts/provide_tx_service
Environment=PATH=/home/nima/miniconda3/envs/qw/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/nima/code/crypto/py/eth_data
ExecStartPre=/bin/bash -c 'source /home/nima/miniconda3/etc/profile.d/conda.sh && conda activate qw && python -c "import web3; print(\"Dependencies OK\")"'
ExecStart=/bin/bash -c 'source /home/nima/miniconda3/etc/profile.d/conda.sh && conda activate qw && python validation_service.py'
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=2G
CPUQuota=200%

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/nima/code/crypto/py/eth_data
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target